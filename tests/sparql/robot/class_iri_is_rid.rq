PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

#
# Part of the RadLex ontology SPARQL test suite. Bindings to this query represent violations of the test.
#
# Test that every class in the RadLex namespace has an IRI local name of the form RID<digits>. Two classes
# violate this today (RadLex_term and Non-RadLex_term, both direct children of RID0), so the check is
# registered at WARN until the committee decides whether they are renumbered or retired.
#
# VIOLATIONS will be bindings that have, on ?entity, ?property, and ?value respectively:
# - The class whose IRI does not follow the RID<digits> pattern.
# - rdf:type.
# - The offending local name.
#
SELECT ?entity ?property ?value
WHERE {
    ?entity a owl:Class .
    FILTER(isIRI(?entity))
    FILTER(STRSTARTS(STR(?entity), "http://www.radlex.org/RID/"))
    FILTER(!REGEX(STR(?entity), "^http://www\\.radlex\\.org/RID/RID[0-9]+$"))
    BIND(rdf:type AS ?property)
    BIND(REPLACE(STR(?entity), "^http://www\\.radlex\\.org/RID/", "") AS ?value)
}
