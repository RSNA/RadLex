PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

#
# Part of the RadLex ontology SPARQL test suite. Bindings to this query represent violations of the test.
#
# Test that no annotation assertion has an empty or whitespace-only value. An empty assertion falsely signals
# that the field is populated. Every declared owl:AnnotationProperty is covered, plus rdfs:label, which is a
# built-in and therefore not declared.
#
# VIOLATIONS will be bindings that have, on ?entity, ?property, and ?value respectively:
# - The entity carrying the empty assertion.
# - The annotation property.
# - The empty or whitespace value.
#
SELECT ?entity ?property ?value
WHERE {
    { ?property a owl:AnnotationProperty } UNION { BIND(rdfs:label AS ?property) }
    ?entity ?property ?value .
    FILTER(isLiteral(?value))
    FILTER(REGEX(STR(?value), "^\\s*$"))
}
