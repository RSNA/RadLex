PREFIX rid: <http://www.radlex.org/RID/>

#
# Part of the RadLex ontology SPARQL test suite. Bindings to this query represent violations of the test.
#
# Test that every rid:Replaced_by value is an IRI reference to another class, not a string literal such as
# "RID11030". A literal cannot be followed by tooling that walks obsolete terms to their replacements.
#
# VIOLATIONS will be bindings that have, on ?entity, ?property, and ?value respectively:
# - The obsolete class carrying the pointer.
# - rid:Replaced_by.
# - The literal value that should have been an IRI.
#
SELECT ?entity ?property ?value
WHERE {
    BIND(rid:Replaced_by AS ?property)
    ?entity ?property ?value .
    FILTER(isLiteral(?value))
}
