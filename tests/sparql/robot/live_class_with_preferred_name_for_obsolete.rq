PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rid: <http://www.radlex.org/RID/>

#
# Part of the RadLex ontology SPARQL test suite. Bindings to this query represent violations of the test.
#
# Test that only obsolete classes carry rid:Preferred_Name_for_Obsolete. An obsolete class is one filed,
# directly or through another obsolete class, under RID15849 ("Obsolete RadLex Term"). A live class carrying
# the property was made obsolete in name but never filed under RID15849, so tools that exclude RID15849's subclasses
# still offer it as a live term.
#
# VIOLATIONS will be bindings that have, on ?entity, ?property, and ?value respectively:
# - The live class carrying the property.
# - rid:Preferred_Name_for_Obsolete.
# - The obsolete name.
#
SELECT ?entity ?property ?value
WHERE {
    BIND(rid:Preferred_Name_for_Obsolete AS ?property)
    ?entity ?property ?value .
    FILTER NOT EXISTS { ?entity rdfs:subClassOf+ rid:RID15849 }
}
