PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rid: <http://www.radlex.org/RID/>

#
# Part of the RadLex ontology SPARQL test suite. Bindings to this query represent violations of the test.
#
# Test that no live class is asserted as a subclass of a retired class. A retired class is one that carries
# rid:Preferred_Name_for_Obsolete or is filed under RID15849 ("Obsolete RadLex Term"). RID15849 itself is
# exempt as a parent, since retired classes are meant to hang under it, and a retired child under a retired
# parent is not reported.
#
# VIOLATIONS will be bindings that have, on ?entity, ?property, and ?value respectively:
# - The live class.
# - rdfs:subClassOf.
# - The retired parent.
#
SELECT DISTINCT ?entity ?property ?value
WHERE {
    BIND(rdfs:subClassOf AS ?property)
    ?entity ?property ?value .
    FILTER(isIRI(?value))
    FILTER(?value != rid:RID15849)
    { ?value rid:Preferred_Name_for_Obsolete ?_pname } UNION { ?value rdfs:subClassOf rid:RID15849 }
    FILTER NOT EXISTS { ?entity rid:Preferred_Name_for_Obsolete ?_cname }
    FILTER NOT EXISTS { ?entity rdfs:subClassOf rid:RID15849 }
}
