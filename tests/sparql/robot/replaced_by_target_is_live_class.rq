PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rid: <http://www.radlex.org/RID/>

#
# Part of the RadLex ontology SPARQL test suite. Bindings to this query represent violations of the test.
#
# Test that a rid:Replaced_by pointer aims at a class that exists and is not itself retired. A retired class is
# one that carries rid:Preferred_Name_for_Obsolete or is filed under RID15849 ("Obsolete RadLex Term"). A pointer
# to a retired class is a chained retirement that was never re-pointed at the live replacement; a pointer to an
# undeclared IRI dangles.
#
# VIOLATIONS will be bindings that have, on ?entity, ?property, and ?value respectively:
# - The retired class carrying the pointer.
# - rid:Replaced_by.
# - The target IRI that is retired or undeclared.
#
SELECT DISTINCT ?entity ?property ?value
WHERE {
    BIND(rid:Replaced_by AS ?property)
    ?entity ?property ?value .
    FILTER(isIRI(?value))
    {
        FILTER NOT EXISTS { ?value a owl:Class }
    }
    UNION
    {
        { ?value rid:Preferred_Name_for_Obsolete ?_name } UNION { ?value rdfs:subClassOf rid:RID15849 }
    }
}
